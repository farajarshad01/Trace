# ── Required ────────────────────────────────────────────────────────────
APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_API_KEY=your-gemini-api-key

# ── Optional: Gemini tuning (defaults shown) ────────────────────────────
# GEMINI_MODEL=gemini-3.8-flash
# Second quota bucket used when the primary is overloaded. "none" disables.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# low | medium | high | none.  Extraction does not need "medium".
# GEMINI_THINKING_LEVEL=low
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_RETRIES=3

# ── Optional: worker budget ─────────────────────────────────────────────
# Seconds between background Gemini calls. 6 = max 10 requests/minute
# (safe for the free tier). Paid tiers can use 0.5.
# GEMINI_MIN_INTERVAL_SECONDS=6
# Hard cap on Gemini calls per hourly run; leftovers wait for the next run.
# MAX_ANALYSES_PER_RUN=20
# MAX_DETAIL_FETCHES_PER_SOURCE=40

# ── Optional: HTTP ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# CORS_ORIGINS=http://localhost:5173,https://your-app.example.com
# MAX_RESUME_BYTES=5242880
